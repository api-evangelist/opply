          "id": "e22471be-e855-4be0-b3e7-3457f62c3cd0",
          "name": "List companies the current user can act on",
          "request": {
            "name": "List companies the current user can act on",
            "description": {
              "content": "Returns the set of companies the authenticated user can target in API calls.\n\n- Staff users: marker response indicating \"all\" — no list is returned.\n- Merchant of Record users: their managed companies plus their own.\n- Brand (buyer) and Supplier users: their own company only.\n\nUsed by the MCP `list_accessible_companies` tool. Also useful for any client\nthat needs to render a company-picker scoped to the user's permissions.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "companies",
                "accessible",
                "me",
                ""
