{
  "opencollection": "1.0.0",
  "info": {
    "name": "Opply Activity Feed Integrations API",
    "version": "0.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Integrations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Deterministic Xero supplier-spend breakdown for the current buyer.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/integrations/xero/supplier-spend/",
            "params": [
              {
                "name": "window_months",
                "value": "",
                "type": "query",
                "description": "Look-back window in months (default 12, clamped to 1..36)."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Deterministic supplier-spend metrics over the buyer's ingested Xero bills."
        }
      ]
    }
  ],
  "bundled": true
}