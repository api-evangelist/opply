        {
          "id": "d7a9e4cc-6501-43c0-97d4-a31d0d73b87c",
          "name": ".well known oauth protected resource retrieve",
          "request": {
            "name": ".well known oauth protected resource retrieve",
            "description": {
              "content": "RFC 9728 — OAuth 2.0 Protected Resource Metadata.\n\nAdvertised at /.well-known/oauth-protected-resource for the main Opply MCP,\nand at a path-scoped variant per additional MCP endpoint (e.g. Zendesk at\n/.well-known/oauth-protected-resource/api/v1/mcp/zendesk). ``resource_suffix``\nis appended to the ``/api/v1/mcp/`` base so the advertised ``resource``\nmatches the endpoint the client is connecting to.\n\n``scopes_supported`` is scoped to the endpoint so each MCP has its own consent\nsurface: ``scope_prefix`` narrows to a single endpoint's scopes (e.g.\n``zendesk`` → ``zendesk:read``/``zendesk:write``), while\n``exclude_scope_prefixes`` drops another endpoint's scopes from the main\nmetadata (so the root Opply MCP does not advertise ``zendesk:*``).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ".well-known",
                "oauth-protected-resource"
              ],
              "host": [
