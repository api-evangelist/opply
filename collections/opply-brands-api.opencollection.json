          "info": {
            "name": "Acknowledge marketplace T&Cs for the current brand company.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/companies/brands/acknowledge-marketplace-terms-and-conditions/",
            "auth": {
