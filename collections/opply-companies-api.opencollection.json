              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Validate the given Allianz company ID against the Allianz API and, on success, persist allianz_company_id and is_connected_to_allianz=True on the buyer. Set skip_validation=true to bypass the API call (for local/staging environments)."
        },
